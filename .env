ASPNETCORE_ENVIRONMENT=Development
#ASPNETCORE_URLS=http://+:80
ASPNETCORE_URLS=http://localhost:5069



# Integration Import DB Configuration
INTEGRATIONIMPORT_DB_PROVIDER=postgres
INTEGRATIONIMPORT_DB_POSTGRES_USER=importuser
INTEGRATIONIMPORT_DB_POSTGRES_PASSWORD=importpass
INTEGRATIONIMPORT_DB_POSTGRES_DB=importdb
#INTEGRATIONIMPORT_DB_CONNECTION=Host=integrationimport-db;Port=5432;Database=importdb;Username=importuser;Password=importpass;Include Error Detail=true

#localhost
INTEGRATIONIMPORT_DB_CONNECTION=Host=localhost;Port=5434;Database=importdb;Username=importuser;Password=importpass

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Kafka Configuration Producer/Consumer - Import 


# Kafka Configuration Resilience - reconnect / socket
#KAFKA_BOOTSTRAP_SERVERS=kafka1:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
IMPORT_KAFKA_RECONNECT_BACKOFF_MS=100
IMPORT_KAFKA_RECONNECT_BACKOFF_MAX_MS=10000
IMPORT_KAFKA_SOCKET_CONNECTION_SETUP_TIMEOUT_MS=10000
IMPORT_KAFKA_SOCKET_TIMEOUT_MS=60000

# Kafka Producer
IMPORT_KAFKA_TOPIC=integrationimport-jobs
IMPORT_KAFKA_RETRY_BACKOFF_MS=100
IMPORT_KAFKA_REQUEST_TIMEOUT_MS=30000
IMPORT_KAFKA_MESSAGE_TIMEOUT_MS=120000

# Kafka Consumer
IMPORT_KAFKA_CONSUMER_GROUP=integrationimport-consumers
IMPORT_KAFKA_AUTO_OFFSET_RESET=Earliest
IMPORT_KAFKA_SESSION_TIMEOUT_MS=30000
IMPORT_KAFKA_MAX_POLL_INTERVAL_MS=300000

#AUTH_API_BASE_URL=http://auth-api
AUTH_API_BASE_URL = http://localhost:5032


